definir tourner_droite:
    tourner_gauche
    tourner_gauche
    tourner_gauche

definir ligne_droite:
    tant que balise_ici:
        ramasser_balise
    tant que devant_libre:
        avancer
        tant que balise_ici:
            ramasser_balise

definir changer_ligne:
    si regarde_est:
        si gauche_libre:
            tant que balise_ici:
                ramasser_balise
            tourner_gauche
            avancer
            tourner_gauche
    sinon:
        si droite_libre:
            tant que balise_ici:
                ramasser_balise
            tourner_droite
            avancer
            tourner_droite

repeter 5 fois:
    ligne_droite
    changer_ligne