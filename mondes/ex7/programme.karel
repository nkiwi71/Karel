definir tourner_droite:
    tourner_gauche
    tourner_gauche
    tourner_gauche

definir ligne_droite:
    si balise_ici:
        ramasser_balise
    tant que devant_libre:
        avancer
        si balise_ici:
            ramasser_balise

definir changer_ligne:
    si regarde_est:
        si gauche_libre:
            tourner_gauche
            avancer
            tourner_gauche
    sinon:
        si droite_libre:
            tourner_droite
            avancer
            tourner_droite

repeter 4 fois:
    ligne_droite
    changer_ligne