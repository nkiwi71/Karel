definir tourner_droite:
    tourner_gauche
    tourner_gauche
    tourner_gauche

definir ligne_droite:
    tant que balise_ici:
        ramasser_balise
    tant que devant_libre:
        avancer
        tant que balise_ici:
            ramasser_balise

definir changer_ligne:
    si regarde_est:
        si gauche_libre:
            tourner_gauche
            avancer
            tant que balise_ici:
                ramasser_balise
            tourner_gauche
    sinon:
        si droite_libre:
            tourner_droite
            avancer
            tant que balise_ici:
                ramasser_balise
            tourner_droite

definir aller_bas_gauche:
    tant que pas regarde_sud:
        tourner_gauche
    tant que devant_libre:
        avancer
    si droite_libre:
        tourner_droite
        tant que devant_libre:
            avancer
    tant que pas regarde_est:
        tourner_gauche

aller_bas_gauche
repeter 5 fois:
    ligne_droite
    changer_ligne